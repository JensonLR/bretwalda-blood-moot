# dependencies
/node_modules

# Next.js build artifacts
/.next
/out
/build

# production
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# environment — NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# misc
.DS_Store
*.pem
.vercel
*.tsbuildinfo

# generated capture output
art/shots/
!art/shots/baseline/

# TS incremental build info
tsconfig.tsbuildinfo

# UI screenshots are regenerable via npm run uishots
art/ui/

# Transpiled output the cosmetic harness emits so it can import the
# renderer outside a browser. Regenerated on every run.
.cosmetictest/
# transpile cache for tools/hairprobe.mjs
.hairprobe/

# Transpiler scratch from the head/wear tape measures. tools/headmeasure.mjs
# and tools/wearmeasure.mjs emit into the repo on purpose (they need node to
# resolve `three` from the repo`s own node_modules) and clean up after
# themselves; a killed run leaves them behind and a `git add -A` swept them in.
.tb/
.headmeasure/
.wearmeasure/
.beardcount/
.beardseat/
.goretest/
.gorestat/
.jank/
.vfxprobe/
# transpile cache for tools/teamread.mjs
.teamread/
# transpile cache and artefacts for tools/freezetest.mjs (same reason as above:
# it tsc-emits anim.ts so node can resolve `three` from the repo's node_modules)
.freeze/
# transpile cache for tools/spectatetest.mjs (it tsc-emits camera.ts for the
# same reason freezetest emits anim.ts)
.spectate/
# transpile cache for tools/gravitytest.mjs (it tsc-emits anim.ts, same seam)
.gravity/
# ...and for tools/replaytest.mjs, which uses the same seam
.replay/

# Git worktrees the agent harness creates for isolated parallel work. These are
# whole checkouts of this repository living inside it — `git worktree list`
# shows them as live, locked trees. A `git add -A` sweeps in ~8 MB of nested
# copy and would commit the repo into itself; ignoring the directory is the
# only correct answer.
.claude/

# CPU look sheets (tools/facelook.mjs) and its transpile cache
/.facelook
art/look/
art/carry/
art/fit/
.probe/
.whereout/
.faceseam/
.locktest/
.facecover/
.beardvolume/
# tools/manespread.mjs shipped without this line and left `.manespread/` sitting
# untracked in `git status` after every run — the same sweep the note above
# warns about, one tool later.
.manespread/
# transpile cache for tools/hoodfall.mjs
.hoodfall/
.helmclash/
# transpile cache for tools/rungcensus.mjs
.rungcensus/
# esbuild bundle for tools/crownnews.mjs
.crownnews/
# scratch transpile caches an agent's own probes emit. Same sweep the note
# over `.tb/` warns about: an unignored one gets swept in by `git add -A`,
# and round eight committed four of them before noticing.
.napeprobe/
.dbg3b/
.dbgdump/
.dbgflare/
.neckprobe/

# Agent probe output. Adversaries shoot hundreds of frames to settle a question
# by looking rather than by reading; the verdict belongs in OPEN-DEFECTS, the
# 21 MB of PNGs does not. Same reasoning as art/shots/ and art/ui/ above.
art/adversary*/
art/probe-*/

# The back review's evidence run — the ten rounds of the coifed mane, the
# baldric before/after, the wyrm's tail. 63 MB of PNGs; the verdicts live in
# OPEN-DEFECTS and ARMOURY-REVIEW-PLAN, the frames regenerate from the
# commands recorded there. Same reasoning as art/shots/ and art/probe-*/.
art/backreview/
art/wyrm2/

# next-env.d.ts is REGENERATED BY NEXT AND ITS CONTENT DEPENDS ON WHICH COMMAND
# RAN LAST. Next 16 writes `./.next/types/routes.d.ts` after a production build
# and `./.next/dev/types/routes.d.ts` after the dev server, so it flips every
# time a harness that builds runs beside one that serves. It has already cost
# this repository one commit that changed nothing else and a stop-hook warning
# on a clean tree.
#
# Safe to drop because it is not load-bearing: `npm run typecheck` was run with
# the file MOVED ASIDE and still exited 0. The file itself says "This file
# should not be edited", and Next rewrites it on the next dev or build anyway.
next-env.d.ts

# tools/factionread.mjs's tsc scratch, same as .teamread and .rungcensus
.factionread/
.vatprobe/
.dyeprobe/
.ident-*/
.ident-*.keep.ts
.census/
.vat2/
.s72/
.dyeprobe/
.shadow/
.banner/
.hairmail/
.wearsweep/
art/marks/
.scoretest/
.armshot/
.profiletest-db/
.gradesplit/
art/grade/

# THE DESKTOP BUILD's generated parts (PLATFORM-PATH §8). The icons are FORGED
# from `public/icon-512.png` by `tauri icon`, which is the same one mark the PWA
# shell ships — committing the twenty-odd derived files would be a second copy
# free to go stale behind the first, which is the drift `tools/mkicon.mjs`
# exists to prevent. `.github/workflows/desktop.yml` regenerates them on every
# run and so does a local build; `desktop/dist` is the empty frontend directory
# the bundler insists on for a thin client that loads the live deployment.
desktop/src-tauri/icons/
desktop/src-tauri/target/
desktop/dist/
# Tauri regenerates these ACL manifests on every build from the config; they are
# build output, not source. `Cargo.lock` is NOT here on purpose — this crate is
# an application and pinning its dependency graph is the point of committing it.
desktop/src-tauri/gen/

# A Unity/Blender project folder the owner keeps inside this checkout — its own repository, never this one's.
/BRETWALDA - Blood Moot/

# Blender working files and exports (the rebuild) — binaries stay out of git; the scripts that make them are in tools/blender/.
art/blender/
