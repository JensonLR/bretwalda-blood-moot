{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bretwalda Blood Moot",
  "version": "0.1.0",
  "identifier": "com.bretwalda.bloodmoot",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BRETWALDA: BLOOD MOOT",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "url": "https://bretwalda-blood-moot.onrender.com"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
